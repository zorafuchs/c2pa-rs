{
  "name": "c2pa-rs-dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": ["--network=host"],
  "containerEnv": {
    "CARGO_HOME": "/usr/local/cargo",
    "RUST_BACKTRACE": "1"
  },
  // Persist the cargo cache and build output across container rebuilds
  "mounts": [
    "source=c2pa-cargo-registry,target=/usr/local/cargo/registry,type=volume",
    "source=c2pa-cargo-git,target=/usr/local/cargo/git,type=volume",
    "source=c2pa-target,target=/workspace/target,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb",
        "fill-labs.dependi",
        "anthropic.claude-code",
        "anthropic.claude",
        "mhutchie.git-graph",
        "donjayamanne.githistory",
        "esbenp.prettier-vscode",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "rust-analyzer.check.command": "clippy",
        "editor.formatOnSave": true,
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        }
      }
    }
  },
  "postCreateCommand": "sudo chown -R $(id -u):$(id -g) /workspace/target 2>/dev/null || true; cargo fetch || true"
}